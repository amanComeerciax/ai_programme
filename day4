
#include <stdio.h>

// Swap function: do elements ki values exchange karega
void swap(int arr[], int i, int j) {

  int temp = arr[i];

  arr[i] = arr[j];

  arr[j] = temp;
}

void moveZeroes(int arr[], int n) {

  int i = 0;

  // j poore array ko check karega
  for (int j = 0; j < n; j++) {

    // Agar current element zero nahi hai
    if (arr[j] != 0) {

      // Non-zero element ko aage le aao
      swap(arr, i, j);

      // Next non-zero ke liye position aage karo
      i++;
    }
  }
}

#include <stdio.h>

// swap function: do elements ki values exchange karega

void swap(int arr[], int i, int j) {
  int temp = arr[i];
  arr[i] = arr[j];

  arr[j] = temp;
}

void moveZeros(int arr[], int n) {
  int i = 0;

  for (int j = 0; j < n; j++) {
    if (arr[j] != 0) {
      swap(arr, i, j);
      i++;
    }
  }
}

